# Copy this file to ".env" and fill in your real key.
# Get your key from https://www.udemy.com/instructor/account/api/
# It is sent as a Bearer token — a single key is all you need.

UDEMY_API_KEY=your_api_key_here

# Port the backend listens on
PORT=5055

# Access control. Leave DASHBOARD_PASSWORD blank locally (open);
# set it in production to require login (HTTP basic auth).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Cloud copy (Supabase) — see cloud.js. Optional: without these, backups stay
# in ~/dashboard-backups and nothing is uploaded.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-or-service-role-key
# Session pooler string (NOT "Direct connection" — that host is IPv6-only)
SUPABASE_DB_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres
